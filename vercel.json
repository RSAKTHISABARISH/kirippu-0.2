{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "kurippu-backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main.py",
      "buildCommand": "pip install -r requirements.txt"
    },
    "kurippu-frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)",    "destination": { "service": "kurippu-backend" } },
    { "source": "/health",      "destination": { "service": "kurippu-backend" } },
    { "source": "/static/(.*)", "destination": { "service": "kurippu-backend" } },
    { "source": "/(.*)",        "destination": { "service": "kurippu-frontend" } }
  ]
}
